# Copy to .env (git ignores it) and fill in for development on your machine.
# These are for real-provider tests, such as the cloud TTS smoke test. On a
# speaker, keys are entered in the Web UI (Config → Text-to-speech) instead.

# ElevenLabs: https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=

# Google Cloud Text-to-Speech: Cloud console → APIs & Services → Credentials →
# Create credentials → API key. Restrict it to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=
