{
  "name": "Sphinx Documentation Skill",
  "version": "1.0.0",
  "description": "Professional documentation system using Sphinx, PlantUML, and C4 model",
  "author": "Documentation Team",
  "license": "MIT",
  "requirements": [
    "sphinx>=4.0.0",
    "sphinx-rtd-theme>=0.5.0",
    "sphinxcontrib-plantuml>=0.22",
    "myst-parser>=0.15.0",
    "sphinx-needs>=0.7.0",
    "linkify-it-py>=2.0.0"
  ],
  "features": [
    "Professional folder structure",
    "C4 architecture diagrams",
    "Requirements management",
    "PlantUML integration",
    "Markdown support",
    "Live reloading",
    "Documentation templates"
  ],
  "chapters": [
    "introduction",
    "architecture",
    "development",
    "templates",
    "guides",
    "reference",
    "appendices"
  ],
  "setup": {
    "commands": [
      "source .venv/bin/activate",
      "pip install -r docs/source/requirements.txt",
      "cd docs && make html"
    ]
  },
  "output": {
    "formats": ["html", "pdf", "epub"],
    "theme": "sphinx_rtd_theme"
  }
}