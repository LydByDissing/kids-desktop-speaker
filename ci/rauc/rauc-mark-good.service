[Unit]
Description=Mark this RAUC slot good once the speaker is healthy
After=multi-user.target api-server.service
Requires=api-server.service
# Only on a device booted by U-Boot into a RAUC slot, not in the VM.
ConditionKernelCommandLine=rauc.slot
# An unhealthy boot must reboot, or the device stays on a bad slot. Each attempt
# uses up one of the slot's tries, so it eventually falls back to the other slot.
FailureAction=reboot

[Service]
Type=oneshot
RemainAfterExit=yes
# A boot only counts as good once the API answers. Otherwise the slot's boot tries
# run out and U-Boot falls back to the other slot.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do curl -sf http://localhost:8080/health >/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=/usr/bin/rauc status mark-good

[Install]
WantedBy=multi-user.target
