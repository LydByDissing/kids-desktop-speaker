[Unit]
Description=zRAM swap (256MB, lz4)
DefaultDependencies=no
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'modprobe zram && echo lz4 > /sys/block/zram0/comp_algorithm && echo 268435456 > /sys/block/zram0/disksize && mkswap /dev/zram0 && swapon /dev/zram0 --priority 100'
ExecStop=/bin/sh -c 'swapoff /dev/zram0 && echo 1 > /sys/block/zram0/reset'

[Install]
WantedBy=multi-user.target
