[Unit]
Description=Kids Desktop Speaker — API Server
# The certificate names the device by hostname and lives on /data (WEB_REQ_001).
After=network.target kds-hostname.service kds-device-config.service
Wants=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/api-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
