[Unit]
Description=Kids Desktop Speaker — Audio Player
# The hostname names the speaker in the Spotify and AirPlay pickers; avahi
# advertises them. bluealsa-aplay needs BlueALSA running.
After=api-server.service kds-hostname.service avahi-daemon.service bluealsa.service
Wants=api-server.service

[Service]
Type=simple
ExecStart=/usr/local/bin/audio-player
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
