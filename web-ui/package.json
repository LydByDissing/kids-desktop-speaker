{
  "name": "kids-speaker-web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Kids Desktop Speaker's Web UI (DEC-045)",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
