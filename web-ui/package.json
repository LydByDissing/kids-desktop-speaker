  "dependencies": {
    "preact": "10.29.8",
    "qrcode-generator": "1.5.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/preact": "8.6.19",
    "@storybook/preact-vite": "8.6.19",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "jsdom": "26.1.0",
    "storybook": "8.6.19",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
